# =============================================================================
# Next.js app
# =============================================================================
# Full URL (NOT just the project ref). Find under Settings → API Keys, or use:
# https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://magbntfegxvbigjmqijr.supabase.co

# Settings → API Keys → Publishable key (sb_publishable_...)
# Maps to the SDK "anon" key — keep the variable name below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL for auth email links (Render: https://spilltherent.onrender.com)
# Also set Supabase Dashboard → Authentication → URL Configuration:
#   Site URL = this value
#   Redirect URLs = https://spilltherent.onrender.com/**  (and http://localhost:3000/** for dev)
NEXT_PUBLIC_SITE_URL=https://spilltherent.onrender.com

# =============================================================================
# Pipeline & server-only (never use NEXT_PUBLIC_ prefix)
# =============================================================================
# Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → URI (optional until you run pipeline)
DATABASE_URL=

# Optional: same URL for Python pipeline
SUPABASE_URL=https://magbntfegxvbigjmqijr.supabase.co

# Google Places / Street View — server & pipeline only (never NEXT_PUBLIC_)
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Used by: pipeline scripts, /api/submissions/building, /api/streetview proxy

# =============================================================================
# Supabase Auth SMTP (configure in Supabase Dashboard → Authentication → SMTP)
# ZeptoMail — not read by this app directly
# =============================================================================
# Host: smtp.zeptomail.com
# Port: 587
# Username: emailapikey
# Password: set ZEPTO_SMTP_PASSWORD in Supabase dashboard (or env for reference)
# From: noreply@spilltherent.com
# ZEPTO_SMTP_PASSWORD=

# Contact form (About page) — ZeptoMail Send Mail token
# https://www.zoho.com/zeptomail/help/api/email-sending.html
# ZEPTO_MAIL_API_KEY=
# CONTACT_EMAIL_TO=jmcanboy@gmail.com
# CONTACT_EMAIL_FROM=noreply@spilltherent.com

# GitHub Actions watchlist cron (same value on Render + GitHub Secrets)
# CRON_SECRET=

# Lease Shield / Stripe — see docs/PRODUCTION_LAUNCH.md
# Test: sk_test_... + whsec_... webhook → https://spillthe.rent/api/stripe/webhook
# Event: checkout.session.completed
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# CARTO dark basemap (required — without it tiles show "API KEY REQUIRED" watermark)
# Free key: https://carto.com/basemaps/apikey/  (fair use ~5M tiles/month)
# NEXT_PUBLIC_CARTO_API_KEY=

# Optional analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=spillthe.rent
